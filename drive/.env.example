# Copy to .env.local for `npm run dev`. On Vercel, set these in the project's
# Environment Variables instead. Never commit real values.

ANTHROPIC_API_KEY=
# 6 to 12 digits; 8 or more recommended.
DRIVE_PASSCODE=

# Optional: turns on the fleet card. dash.tessie.com/settings/api
TESSIE_TOKEN=
# Optional: a few sentences about you that Claude reads on every message.
DRIVE_PROFILE=
# Optional: JSON array of home tiles, e.g. [{"label":"Market pulse","prompt":"..."}]
DRIVE_TILES=
